---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found — Tosin Oseni" description="This page doesn’t exist." noindex>
  <section aria-labelledby="not-found-title">
    <h1 id="not-found-title" class="font-display text-[clamp(2.75rem,7vw,3.75rem)] leading-[1.1] tracking-[-0.03em]">Lost.</h1>
    <p class="mt-5 max-w-[440px] text-base leading-7 text-muted">That page doesn’t exist, or it moved.</p>
    <a href="/" class="mt-8 inline-block text-sm decoration-ink/30 underline-offset-4 hover:underline">← Back home</a>
  </section>
</Layout>
