---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found — Tosin Oseni" description="This page doesn’t exist." noindex>
  <section aria-labelledby="not-found-title">
    <h1 id="not-found-title" class="display">Lost.</h1>
    <p class="mt-5 max-w-[34ch] text-xl leading-snug text-muted sm:text-2xl">That page doesn’t exist, or it moved.</p>
    <a href="/" class="mt-8 inline-block text-sm underline decoration-rule underline-offset-4 hover:decoration-pass">← Back home</a>
  </section>
</Layout>
