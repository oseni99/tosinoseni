---
import ArrowUpRight from '../components/ArrowUpRight.astro';
import Layout from '../layouts/Layout.astro';
import StackSnake from '../components/StackSnake.astro';
import { profile } from '../data/profile';
const heading = 'mb-5 text-[12px] font-medium tracking-[0.14em]';
---
<Layout>
  <section aria-labelledby="intro">
    <p class="mb-5 text-[9px] font-medium uppercase tracking-[0.22em] text-muted sm:text-[10px]">Software engineer & curious human</p>
    <h1 id="intro" class="font-display text-[clamp(3.5rem,8vw,5.3rem)] leading-[1.08] tracking-[-0.035em]">Hi, I’m {profile.shortName}.</h1>
    <p class="mt-6 max-w-[490px] text-xl leading-relaxed tracking-[-0.02em] sm:text-[23px]">{profile.intro}</p>
    <p class="mt-5 max-w-[470px] text-[14px] leading-7 text-muted sm:text-[15px]">{profile.about}</p>
    <StackSnake showLauncher={false} />
  </section>
  <section aria-labelledby="lately" class="mt-8">
    <h2 id="lately" class={heading}>Lately</h2>
    <div class="text-[13px] leading-6 text-muted sm:text-sm">{profile.lately.map(line => <p>{line}</p>)}</div>
  </section>
  <section aria-labelledby="experience" class="mt-7">
    <h2 id="experience" class={heading}>Along the way</h2>
    <ul class="space-y-3 px-3 text-[13px] sm:px-4 sm:text-sm">
      {profile.experience.map(job => <li class="flex items-center justify-between gap-x-5">
        <span class="inline-flex min-w-0 items-center text-muted">
          <img src={job.icon} alt="" width="18" height="18" class="mr-2.5 size-[18px] shrink-0 object-contain" />
          <span class="w-[3ch] shrink-0">{job.role}</span><span aria-hidden="true" class="mx-2 shrink-0 text-muted/60">·</span><span class="min-w-0 text-ink">{job.company}</span>
        </span>
        <span class="shrink-0 text-[11px] tabular-nums text-muted sm:text-xs">{job.date}</span>
      </li>)}
    </ul>
  </section>
  <section aria-labelledby="projects" class="mt-7">
    <h2 id="projects" class={heading}>Selected projects</h2>
    <ul class="space-y-4">
      {profile.projects.map(project => <li>
        <h3 class="text-[13px] font-medium sm:text-sm"><a href={project.url} class="decoration-ink/30 underline-offset-4 hover:underline">{project.name} <span aria-hidden="true"><ArrowUpRight /></span></a></h3>
        <p class="mt-1 text-xs leading-5 text-muted">{project.description}</p>
      </li>)}
    </ul>
    <a href={profile.github} class="mt-5 inline-block text-xs text-muted decoration-ink/30 underline-offset-4 hover:text-ink hover:underline">Browse my GitHub <span aria-hidden="true"><ArrowUpRight /></span></a>
  </section>
  <section aria-labelledby="hackathons" class="mt-7">
    <h2 id="hackathons" class={heading}>Hackathons [5x winner]</h2>
    <ul class="space-y-6">
      {profile.hackathons.map(event => <li>
        <div class="flex flex-col items-start gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-x-4">
          <h3 class="text-[13px] font-medium sm:text-sm">{'url' in event ? <a href={event.url} class="decoration-ink/30 underline-offset-4 hover:underline">{event.name} <span aria-hidden="true"><ArrowUpRight /></span></a> : event.name}</h3>
          <span class="text-[11px] text-muted">{event.result}</span>
        </div>
        <p class="mt-1 text-xs leading-5 text-muted">{event.description}</p>
        {'photos' in event && <details class="mt-2 text-xs">
          <summary class="w-fit cursor-pointer text-muted underline decoration-ink/25 underline-offset-4 hover:text-ink">View 2 photos</summary>
          <div class="mt-3 grid grid-cols-2 gap-2">
            {event.photos?.map(photo => <a href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={`Open photo: ${photo.alt}`}><img src={photo.src} alt={photo.alt} width="700" height="467" loading="lazy" class="aspect-[3/2] w-full object-cover" /></a>)}
          </div>
        </details>}
      </li>)}
    </ul>
  </section>
</Layout>
