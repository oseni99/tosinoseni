---
import Layout from '../layouts/Layout.astro';

import { profile } from '../data/profile';
// Résumé-style rows: section name in a left column on wide screens, stacked on narrow ones.
const row = 'mt-14 grid gap-y-3 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-x-8';
const heading = 'text-sm text-muted sm:pt-0.5';
const link = 'underline decoration-rule decoration-1 underline-offset-4 transition-colors hover:decoration-pass';
---
<Layout>
  <section aria-labelledby="intro">
    <h1 id="intro" class="display">Hi, I’m {profile.shortName}.</h1>
    <p class="mt-6 max-w-[36ch] text-balance text-xl leading-snug sm:text-2xl">{profile.intro}</p>
    <p class="mt-5 text-muted">Say hi: <a href={`mailto:${profile.email}`} class={`text-ink ${link}`}>{profile.email}</a></p>
  </section>

  <section aria-labelledby="lately" class={row}>
    <h2 id="lately" class={heading}>Lately</h2>
    <div class="space-y-1 leading-relaxed">{profile.lately.map(line => <p>{line}</p>)}</div>
  </section>

  <section aria-labelledby="experience" class={row}>
    <h2 id="experience" class={`${heading} sm:pt-3`}>Along the way</h2>
    <ul class="divide-y divide-rule border-y border-rule">
      {profile.experience.map(job => <li class="flex items-center gap-x-3 py-2.5">
        <img src={job.icon} alt="" width="18" height="18" class="size-[18px] shrink-0 object-contain" />
        <span class="min-w-0 flex-1 truncate font-medium">{job.company}</span>
        <span class="w-[4ch] text-muted">{job.role}</span>
        <span class="tabular-nums text-muted">{job.date}</span>
      </li>)}
    </ul>
  </section>

  <section aria-labelledby="projects" class={row}>
    <h2 id="projects" class={heading}>Selected projects</h2>
    <div>
      <ul class="space-y-4">
        {profile.projects.map(project => <li>
          <h3 class="font-medium"><a href={project.url} class={link}>{project.name}</a></h3>
          <p class="mt-0.5 text-muted">{project.description}</p>
        </li>)}
      </ul>
      <a href={profile.github} class={`mt-5 inline-block text-sm text-muted hover:text-ink ${link}`}>Browse my GitHub</a>
    </div>
  </section>

  <section aria-labelledby="hackathons" class={row}>
    <h2 id="hackathons" class={`${heading} sm:pt-3.5`}>Hackathons [5x winner]</h2>
    <ul class="divide-y divide-rule border-y border-rule">
      {profile.hackathons.map(event => <li class="grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-4 py-3">
        <h3 class="font-medium">{'url' in event ? <a href={event.url} class={link}>{event.name}</a> : event.name}</h3>
        <span class="text-right font-semibold text-pass">{event.won}</span>
        {'photos' in event && <details class="col-span-2 mt-2 text-sm">
          <summary class="w-fit cursor-pointer text-muted hover:text-ink">View 2 photos</summary>
          <div class="mt-3 grid grid-cols-2 gap-2">
            {event.photos?.map(photo => <a href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={`Open photo: ${photo.alt}`}><img src={photo.src} alt={photo.alt} width="700" height="467" loading="lazy" class="aspect-[3/2] w-full rounded-sm object-cover" /></a>)}
          </div>
        </details>}
      </li>)}
    </ul>
  </section>
</Layout>
