---
import Layout from '../layouts/Layout.astro';

import { profile } from '../data/profile';
const heading = 'mb-3 text-xs text-muted';
const link = 'decoration-ink/30 underline-offset-4 hover:underline';
---
<Layout>
  <section aria-labelledby="intro">
    <h1 id="intro" class="font-display text-[clamp(2.75rem,7vw,3.75rem)] leading-[1.1] tracking-[-0.03em]">Hi, I’m {profile.shortName}.</h1>
    <p class="mt-5 max-w-[470px] text-lg leading-relaxed tracking-[-0.01em]">{profile.intro}</p>

    <p class="mt-5 text-sm text-muted">Say hi: <a href={`mailto:${profile.email}`} class={`text-ink ${link}`}>{profile.email}</a></p>
  </section>
  <section aria-labelledby="lately" class="mt-7">
    <h2 id="lately" class={heading}>Lately</h2>
    <div class="text-sm leading-6">{profile.lately.map(line => <p>{line}</p>)}</div>
  </section>
  <section aria-labelledby="experience" class="mt-7">
    <h2 id="experience" class={heading}>Along the way</h2>
    <ul class="space-y-2 text-sm">
      {profile.experience.map(job => <li class="flex items-center justify-between gap-x-5">
        <span class="inline-flex min-w-0 items-center">
          <img src={job.icon} alt="" width="18" height="18" class="mr-3 size-[18px] shrink-0 object-contain" />
          <span class="inline-block w-[4ch] shrink-0 text-muted">{job.role}</span>{job.company}
        </span>
        <span class="shrink-0 text-xs tabular-nums text-muted">{job.date}</span>
      </li>)}
    </ul>
  </section>
  <section aria-labelledby="projects" class="mt-7">
    <h2 id="projects" class={heading}>Selected projects</h2>
    <ul class="space-y-4">
      {profile.projects.map(project => <li>
        <h3 class="text-sm"><a href={project.url} class={link}>{project.name}</a></h3>
        <p class="mt-0.5 text-xs leading-5 text-muted">{project.description}</p>
      </li>)}
    </ul>
    <a href={profile.github} class="mt-5 inline-block text-xs text-muted decoration-ink/30 underline-offset-4 hover:text-ink hover:underline">Browse my GitHub</a>
  </section>
  <section aria-labelledby="hackathons" class="mt-7">
    <h2 id="hackathons" class={heading}>Hackathons [5x winner]</h2>
    <ul class="space-y-5">
      {profile.hackathons.map(event => <li class="grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-4 text-sm">
        <h3>{'url' in event ? <a href={event.url} class={link}>{event.name}</a> : event.name}</h3>
        <span class="text-xs text-muted">{event.won}</span>
        {'description' in event && <p class="mt-0.5 text-xs leading-5 text-muted">{event.description}</p>}
        {'photos' in event && <details class="col-span-2 mt-2 text-xs">
          <summary class="w-fit cursor-pointer text-muted underline decoration-ink/25 underline-offset-4 hover:text-ink">View 2 photos</summary>
          <div class="mt-3 grid grid-cols-2 gap-2">
            {event.photos?.map(photo => <a href={photo.src} target="_blank" rel="noopener noreferrer" aria-label={`Open photo: ${photo.alt}`}><img src={photo.src} alt={photo.alt} width="700" height="467" loading="lazy" class="aspect-[3/2] w-full object-cover" /></a>)}
          </div>
        </details>}
      </li>)}
    </ul>
  </section>
</Layout>
