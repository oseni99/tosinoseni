---
import ArrowUpRight from '../components/ArrowUpRight.astro';
import Layout from '../layouts/Layout.astro';
import StackSnake from '../components/StackSnake.astro';
import { profile } from '../data/profile';
---
<Layout title="Résumé & Interests — Tosin Oseni" description="Explore Tosin Oseni’s résumé, coding practice, personal interests, and Stack Snake browser game." elsewhere>
  <section aria-labelledby="elsewhere-title">
    <h1 id="elsewhere-title" class="font-display text-[clamp(2.75rem,7vw,3.75rem)] leading-[1.1] tracking-[-0.03em]">Elsewhere.</h1>
    <p class="mt-5 max-w-[440px] text-base leading-7 text-muted">My résumé, coding practice, games, and a place for notes along the way.</p>
    <div class="mt-10 divide-y divide-ink/10">
      <a href="/tosinoseni.pdf" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between gap-5 py-4">
        <div><h2 class="text-sm">Résumé</h2><p class="mt-1 text-xs leading-5 text-muted">A little more about my experience · PDF</p></div>
        <span aria-hidden="true" class="text-muted transition-colors group-hover:text-ink"><ArrowUpRight /></span>
      </a>
      <a href={profile.leetcode} class="group flex items-center justify-between gap-5 py-4">
        <div><h2 class="text-sm">LeetCode</h2><p class="mt-1 text-xs leading-5 text-muted">My coding practice and problem solving.</p></div>
        <span aria-hidden="true" class="text-muted transition-colors group-hover:text-ink"><ArrowUpRight /></span>
      </a>
      <section aria-labelledby="gaming-title" class="py-4">
        <h2 id="gaming-title" class="text-sm">Video games</h2>
        <p class="mt-1 text-xs leading-5 text-muted">I play video games too. Hit me up!</p>
        <p class="mt-3 text-xs text-muted">PSN <span class="ml-2 text-ink">{profile.psn}</span></p>
      </section>
      <section aria-labelledby="notes-title" class="py-4">
        <h2 id="notes-title" class="text-sm">Notes</h2>
        <p class="mt-1 text-xs leading-5 text-muted">Things I’m learning, ideas I’m exploring, and thoughts in progress.</p>
        <p class="mt-3 text-xs text-muted">Nothing here yet. Soon.</p>
      </section>
      <section aria-labelledby="snake-section-title" class="py-4">
        <h2 id="snake-section-title" class="text-sm">A little break</h2>
        <p class="mt-1 text-xs leading-5 text-muted">Collect technologies and build your stack.</p>
        <div class="mt-4"><StackSnake /></div>
      </section>
    </div>
    <a href="/" class="mt-10 inline-block text-xs text-muted transition-colors hover:text-ink">← Back home</a>
  </section>
</Layout>
