---
import ArrowUpRight from '../components/ArrowUpRight.astro';
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
---
<Layout title="Résumé & Interests — Tosin Oseni" description="Explore Tosin Oseni’s résumé, coding practice, and personal interests." elsewhere>
  <section aria-labelledby="elsewhere-title">
    <h1 id="elsewhere-title" class="display">Elsewhere.</h1>
    <p class="mt-5 max-w-[34ch] text-xl leading-snug text-muted sm:text-2xl">My résumé, coding practice, games, and a place for notes along the way.</p>
    <div class="mt-10 divide-y divide-rule border-y border-rule">
      <a href="/tosinoseni.pdf" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between gap-5 py-4">
        <div><h2 class="font-medium">Résumé</h2><p class="mt-1 text-sm text-muted">A little more about my experience (PDF)</p></div>
        <span aria-hidden="true" class="text-muted transition-colors group-hover:text-pass"><ArrowUpRight /></span>
      </a>
      <a href={profile.leetcode} class="group flex items-center justify-between gap-5 py-4">
        <div><h2 class="font-medium">LeetCode</h2><p class="mt-1 text-sm text-muted">My coding practice and problem solving.</p></div>
        <span aria-hidden="true" class="text-muted transition-colors group-hover:text-pass"><ArrowUpRight /></span>
      </a>
      <section aria-labelledby="gaming-title" class="py-4">
        <h2 id="gaming-title" class="font-medium">Video games</h2>
        <p class="mt-1 text-sm text-muted">I play video games too. Hit me up!</p>
        <p class="mt-3 text-sm text-muted">PSN <span class="ml-2 text-ink">{profile.psn}</span></p>
      </section>
      <section aria-labelledby="notes-title" class="py-4">
        <h2 id="notes-title" class="font-medium">Notes</h2>
        <p class="mt-1 text-sm text-muted">Things I’m learning, ideas I’m exploring, and thoughts in progress.</p>
        <p class="mt-3 text-sm text-muted">Nothing here yet. Soon.</p>
      </section>
    </div>
    <a href="/" class="mt-10 inline-block text-sm text-muted transition-colors hover:text-ink">← Back home</a>
  </section>
</Layout>
