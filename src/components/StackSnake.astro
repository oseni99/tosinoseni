---
interface Props { showLauncher?: boolean }
const { showLauncher = true } = Astro.props;
---
{showLauncher && <button type="button" id="snake-open" hidden class="border border-ink/20 px-3.5 py-2 text-xs text-ink transition-colors hover:border-ink hover:bg-ink hover:text-paper">Play Stack Snake <span aria-hidden="true" class="ml-1">↗</span></button>}

<button type="button" id="snake-teaser" hidden class="snake-teaser" aria-label="Play Stack Snake">
  <span class="snake-teaser-label">Play Stack Snake ↗</span>
  <span class="snake-teaser-body" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i></span>
</button>

<dialog id="stack-snake" aria-labelledby="snake-title" aria-describedby="snake-help" class="snake-dialog">
  <div class="snake-panel">
    <div class="flex items-start justify-between gap-4">
      <div>
        <p class="text-[9px] font-medium uppercase tracking-[0.22em] text-muted">A little Easter egg</p>
        <h2 id="snake-title" class="mt-1 font-display text-[2.5rem] leading-none">Stack Snake.</h2>
      </div>
      <button type="button" id="snake-close" aria-label="Close Stack Snake" class="snake-close">×</button>
    </div>

    <div class="mt-5 flex items-baseline justify-between gap-4 text-xs">
      <p>Stack Size <strong id="snake-score" class="ml-1 font-semibold tabular-nums">0</strong></p>
      <p class="text-muted">Best <span id="snake-best" class="tabular-nums">0</span></p>
    </div>

    <div class="snake-board-wrap mt-3">
      <div id="snake-board" class="snake-board" role="img" tabindex="-1" aria-label="Stack Snake game board"></div>
      <div id="snake-overlay" class="snake-overlay">
        <p id="snake-overlay-title" class="font-display text-3xl">Ready to build?</p>
        <p id="snake-overlay-detail" class="mt-1 text-xs text-muted">Collect technologies. Avoid walls and your tail.</p>
        <button type="button" id="snake-action" class="snake-action mt-4">Start game</button>
        <a id="snake-projects" href="/#projects" class="mt-4 hidden text-xs text-ink underline decoration-ink/30 underline-offset-4">See what I actually built with these →</a>
      </div>
    </div>

    <div class="mt-3 flex min-h-5 items-center justify-between gap-3 text-[11px]">
      <p id="snake-help" class="text-muted"><span class="snake-keyboard-help">Arrow keys or WASD · Space to pause</span><span class="snake-touch-help">Tap arrows to steer</span></p>
      <p id="snake-pickup" aria-live="polite" class="font-medium text-ink"></p>
    </div>

    <div class="snake-controls mt-3" aria-label="Direction controls">
      <button type="button" data-snake-direction="up" aria-label="Move up">↑</button>
      <div>
        <button type="button" data-snake-direction="left" aria-label="Move left">←</button>
        <button type="button" data-snake-direction="down" aria-label="Move down">↓</button>
        <button type="button" data-snake-direction="right" aria-label="Move right">→</button>
      </div>
    </div>

    <div class="mt-4 border-t border-ink/10 pt-3">
      <p class="text-[10px] font-medium uppercase tracking-[0.14em] text-muted">Collected this run</p>
      <p id="snake-collected" class="mt-1 min-h-5 text-xs leading-5 text-muted" aria-live="polite">Nothing yet</p>
    </div>
  </div>
</dialog>

<script>
  import '../scripts/stack-snake';
</script>

<style>
  .snake-teaser { position: fixed; left: 0; bottom: clamp(36px, 10svh, 110px); z-index: 40; display: flex; align-items: center; gap: 12px; width: max-content; padding: 16px 8px; cursor: pointer; will-change: transform; animation: snake-cross 10s linear forwards; }
  .snake-teaser[hidden] { display: none; }
  .snake-teaser-label { padding: 7px 10px; border: 1px solid rgb(37 48 57 / 20%); background: #faf9f6; box-shadow: 0 3px 12px rgb(37 48 57 / 12%); color: #253039; font-size: 11px; white-space: nowrap; animation: snake-label-float 1.6s ease-in-out infinite; }
  .snake-teaser-body { display: flex; align-items: center; gap: 1px; }
  .snake-teaser-body i { display: block; width: 14px; height: 14px; border-radius: 4px; background: #647d80; animation: snake-slither 1.2s ease-in-out infinite; }
  .snake-teaser-body i:nth-child(1) { width: 6px; height: 6px; animation-delay: -0.7s; }
  .snake-teaser-body i:nth-child(2) { width: 9px; height: 9px; animation-delay: -0.6s; }
  .snake-teaser-body i:nth-child(3) { width: 12px; height: 12px; animation-delay: -0.5s; }
  .snake-teaser-body i:nth-child(4) { animation-delay: -0.4s; }
  .snake-teaser-body i:nth-child(5) { animation-delay: -0.3s; }
  .snake-teaser-body i:nth-child(6) { animation-delay: -0.2s; }
  .snake-teaser-body i:nth-child(7) { animation-delay: -0.1s; }
  .snake-teaser-body i:last-child { position: relative; width: 19px; height: 17px; border-radius: 5px 8px 8px 5px; background: #253039; }
  .snake-teaser-body i:last-child::after { position: absolute; top: 3px; right: 4px; width: 3px; height: 3px; border-radius: 50%; background: #faf9f6; box-shadow: 0 8px #faf9f6; content: ''; }
  .snake-teaser:hover, .snake-teaser:focus-visible { animation-play-state: paused; }
  .snake-teaser:focus-visible { animation: none; transform: translate3d(calc(50vw - 50%), 0, 0); }
  @keyframes snake-cross {
    0% { transform: translate3d(-100%, 0, 0); }
    30% { transform: translate3d(calc(45vw - 50%), 0, 0); animation-timing-function: ease-in-out; }
    70% { transform: translate3d(calc(55vw - 50%), 0, 0); animation-timing-function: ease-in; }
    100% { transform: translate3d(100vw, 0, 0); }
  }
  @keyframes snake-slither {
    0%, 100% { transform: translateY(-5px) rotate(-7deg); }
    50% { transform: translateY(5px) rotate(7deg); }
  }
  @keyframes snake-label-float {
    0%, 100% { transform: translateY(-2px); }
    50% { transform: translateY(2px); }
  }
  .snake-dialog { position: fixed; inset: 0; width: min(420px, calc(100vw - 24px)); max-height: calc(100dvh - 24px); margin: auto; padding: 0; overflow: auto; border: 1px solid rgb(37 48 57 / 16%); background: #faf9f6; color: #253039; box-shadow: 0 24px 80px rgb(37 48 57 / 18%); }
  .snake-dialog::backdrop { background: rgb(37 48 57 / 38%); backdrop-filter: blur(3px); }
  .snake-panel { padding: 22px; }
  .snake-close { display: grid; width: 32px; height: 32px; place-items: center; border: 1px solid rgb(37 48 57 / 18%); border-radius: 50%; font-size: 22px; line-height: 1; }
  .snake-board-wrap { position: relative; aspect-ratio: 1; overflow: hidden; border: 1px solid rgb(37 48 57 / 15%); background: #f3f3ef; }
  .snake-board { display: grid; width: 100%; height: 100%; grid-template-columns: repeat(18, minmax(0, 1fr)); grid-template-rows: repeat(18, minmax(0, 1fr)); }
  .snake-board :global(.snake-cell) { display: grid; place-items: center; min-width: 0; min-height: 0; border-right: 1px solid rgb(37 48 57 / 9%); border-bottom: 1px solid rgb(37 48 57 / 9%); }
  .snake-board :global(.snake-body) { background: #647d80; border-color: #f3f3ef; }
  .snake-board :global(.snake-head) { background: #253039; border-color: #f3f3ef; }
  .snake-board :global(.snake-food) { background: #d5e4e6; color: #253039; font-size: clamp(8px, 2.5vw, 11px); font-weight: 700; letter-spacing: -0.05em; }
  .snake-overlay { position: absolute; inset: auto 0 0; display: flex; flex-direction: column; align-items: center; padding: 16px 12px 18px; border-top: 1px solid rgb(37 48 57 / 15%); background: rgb(250 249 246 / 98%); box-shadow: 0 -8px 24px rgb(37 48 57 / 7%); text-align: center; }
  .snake-overlay[hidden] { display: none; }
  .snake-action { min-height: 38px; padding: 0 18px; background: #253039; color: #faf9f6; font-size: 12px; }
  .snake-controls { display: none; flex-direction: column; align-items: center; gap: 4px; }
  .snake-touch-help { display: none; }
  .snake-controls > div { display: flex; gap: 4px; }
  .snake-controls button { width: 48px; height: 36px; border: 1px solid rgb(37 48 57 / 22%); background: #f3f3ef; font-size: 18px; touch-action: manipulation; }
  @media (hover: none), (pointer: coarse) { .snake-controls, .snake-touch-help { display: flex; } .snake-keyboard-help { display: none; } }
  @media (prefers-reduced-motion: reduce) { .snake-teaser { display: none; } }
  @media (max-width: 380px) {
    .snake-panel { padding: 16px; }
    .snake-overlay { padding: 10px 8px 12px; }
    #snake-overlay-title { font-size: 24px; }
    #snake-overlay-detail { display: none; }
    .snake-action, #snake-projects { margin-top: 8px; }
  }
</style>
