---
import '../styles/global.css';
import { profile } from '../data/profile';
interface Props { title?: string; description?: string; elsewhere?: boolean; noindex?: boolean }
const {
  title = 'Tosin Oseni (Oluwatosin Oseni) — Software Engineer',
  description = 'Oluwatosin (Tosin) Oseni is a software engineer and computer science student at Talladega College. Explore his projects, experience, and hackathon work.',
  elsewhere = false,
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/og.png', Astro.site);
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  alternateName: `${profile.shortName} Oseni`,
  jobTitle: 'Software Engineer',
  url: new URL('/', Astro.site).href,
  image: image.href,
  sameAs: [profile.github, profile.linkedin],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0f1214" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Tosin Oseni" />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Tosin Oseni, software engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={image} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body class="min-h-svh">
    <a href="#main" class="sr-only bg-paper px-4 py-2 focus:not-sr-only focus:fixed focus:left-6 focus:top-5 focus:z-50">Skip to content</a>
    <header class="mx-auto flex max-w-5xl items-center justify-between px-7 py-8 sm:px-12 sm:py-10">
      <a href="/" aria-label="Tosin Oseni, home" class="-my-2 py-2 text-xs transition-opacity hover:opacity-60">Tosin Oseni</a>
      <nav aria-label="Main navigation" class="flex gap-7 text-xs">
        <a href="/" aria-current={!elsewhere ? 'page' : undefined} class:list={['-my-2 py-2 transition-colors hover:text-ink', elsewhere ? 'text-muted' : 'text-ink']}>home</a>
        <a href="/elsewhere/" aria-current={elsewhere ? 'page' : undefined} class:list={['-my-2 py-2 transition-colors hover:text-ink', elsewhere ? 'text-ink' : 'text-muted']}>elsewhere</a>
      </nav>
    </header>
    <main id="main" class="mx-auto w-full max-w-[640px] px-7 pb-16 pt-14 sm:px-10 sm:pt-20" tabindex="-1">
      <slot />
      <footer class="mt-10 sm:mt-12">
        <div class="flex flex-wrap gap-x-7 gap-y-0 text-xs text-muted">
          <a href={`mailto:${profile.email}`} class="py-2.5 transition-colors hover:text-ink">Email</a>
          <a href={profile.github} class="py-2.5 transition-colors hover:text-ink">GitHub</a>
          <a href={profile.linkedin} class="py-2.5 transition-colors hover:text-ink">LinkedIn</a>
        </div>
      </footer>
    </main>
  </body>
</html>
